# Milo IQ — environment template
# Copy this file to .env.local and fill in values from your own Firebase project.
#   Firebase Console > Project settings > General > Your apps > SDK setup and configuration
# .env.local is gitignored. Never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional sign-in providers.
# Google is always on. Set these to "true" only AFTER you have enabled the
# provider in Firebase Console > Authentication > Sign-in method.
#   Apple requires a paid Apple Developer account ($99/yr).
#   Microsoft requires a free Azure app registration.
VITE_ENABLE_APPLE=false
VITE_ENABLE_MICROSOFT=false

# --- App Check (optional, recommended before sharing the app widely) --------
# Attests that requests come from your app, not a script pointed at your
# project. Leave blank and the app runs exactly as before, unattested.
#
# Setup: Google Cloud Console > Security > reCAPTCHA, create a key of type
# "Website", add your domains, then register the site key in
# Firebase Console > App Check > Apps.
#
# reCAPTCHA Enterprise bills per assessment beyond a monthly free allowance,
# so keep your budget alert in place.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# On localhost the SDK prints a debug token to the browser console instead of
# calling reCAPTCHA. Register it under App Check > Apps > Manage debug tokens.
# Leave this blank to get a fresh token printed each time; set it to a token
# you have already registered to reuse the same one.
VITE_APPCHECK_DEBUG_TOKEN=
