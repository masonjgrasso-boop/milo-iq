rules_version = '2';

// Phase 1 rules: a user may read and write only their own data, and nothing
// else is reachable. Later phases widen this for groups and coaches, with
// emulator tests covering both the allow and the deny cases.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid} and everything beneath it belongs to that user alone.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Anything not matched above is denied by default.
  }
}
