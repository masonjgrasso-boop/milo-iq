rules_version = '2';

// A user reads and writes only their own images. Sharing into a group works
// by handing out the tokenised download URL, never by widening these rules.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isReasonablePhoto() {
      // Photos are compressed to ~200KB on the device before upload, so a 2MB
      // ceiling is generous while still bounding what a bad actor could store.
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/photos/{week}/{file} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isReasonablePhoto();
      allow delete: if isOwner(uid);
    }

    // Images attached to a group post. They live under their author, like
    // progress photos, and are shared the same way: the post carries the
    // tokenised download URL, which is only ever written into a group the
    // author chose to post in and goes when the post does.
    //
    // Storage rules cannot read Firestore, so there is no way to gate the
    // object itself on group membership without a backend this app does not
    // have. That is the same trade progress-photo sharing already makes; it
    // is written down here rather than left to be discovered.
    match /users/{uid}/posts/{file} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isReasonablePhoto();
      allow delete: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
