rules_version = '2';

// A user reads and writes only their own photos. Group sharing is added in a
// later phase, gated on both group membership and the owner's share settings.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isReasonablePhoto() {
      // Photos are compressed to ~200KB on the device before upload, so a 2MB
      // ceiling is generous while still bounding what a bad actor could store.
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /users/{uid}/photos/{week}/{file} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && isReasonablePhoto();
      allow delete: if isOwner(uid);
    }

    // Everything else is denied by default.
  }
}
